# Backend environment variables.
# Copy to ".env" for local development, and set the same keys in the
# Vercel project settings (Settings -> Environment Variables) for production.

# MongoDB connection string.
# Local dev can use a local mongod, but Vercel CANNOT reach localhost --
# use a MongoDB Atlas connection string in production, e.g.
# mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/mern-estate
MONGO_DB_URL=

# Port for local development only (ignored on Vercel).
PORT=3000

# Secret used to sign JWT auth tokens.
JWT_SECRET=

# Cloudinary credentials (used for signed image uploads).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
